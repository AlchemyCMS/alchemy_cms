Alchemy.configure do |config|
  config.menu.add(
    name: "<%= @module_name %>",
    title: "modules.<%= @module_name %>",
    image: "alchemy/<%= @module_name %>_module.png",
    url: -> { main_app.admin_<%= @index_route %>_path },
    condition: -> { can?(:index, :admin_<%= @controller_name %>) },
    children: [
      {
        title: "modules.<%= @module_name %>",
        url: -> { main_app.admin_<%= @index_route %>_path },
        condition: -> { can?(:index, :admin_<%= @controller_name %>) }
      }
    ]
  )
  config.abilities.add("<%= @controller_class %>Ability")
end
