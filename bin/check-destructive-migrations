#!/usr/bin/env ruby
# frozen_string_literal: true

# Fails when a migration rebuilds a table inside the default DDL transaction, or
# when one that runs outside it cannot be re-run after a partial failure.
#
# SQLite has no real ALTER TABLE, so Rails implements the operations below by
# recreating the table: copy the rows aside, DROP TABLE the original, copy them
# back. With foreign keys enforced, SQLite's DROP TABLE performs an implicit
# DELETE, which fires ON DELETE CASCADE on every child table. The adapter tries
# to prevent that with PRAGMA foreign_keys = OFF, but that pragma is a silent
# no-op inside a transaction and migrations run inside one by default. The
# rebuilt table keeps its rows (they come back from the copy) while every
# cascading descendant is deleted for good: rebuilding alchemy_pages empties
# alchemy_page_versions, alchemy_elements and alchemy_ingredients.
#
# Declaring disable_ddl_transaction! lets the pragma take effect, at the cost of
# atomicity. Since only SQLite rebuilds, the declaration may be conditional on
# the adapter, which keeps the transaction on PostgreSQL and MySQL. Rails
# decides on the transaction before it tells the migration which direction it is
# running (see Migrator#use_transaction?), so the declaration cannot single out
# the down direction -- an up that only adds nullable columns can wrap its own
# body in a transaction instead.

REBUILD_OPERATIONS = %w[
  change_column
  change_column_default
  change_column_null
  remove_column
  remove_columns
  rename_column
  add_timestamps
].freeze

# Accepts the bare declaration and the SQLite-conditional form. A condition on
# any other adapter leaves the rebuild unprotected, so it does not count.
DISABLED_TRANSACTION = /^\s*disable_ddl_transaction!(\s+if\s.*sqlite.*)?$/i

# The rebuild happens in whichever direction drops the column, and on SQLite
# that direction has no transaction to roll back, so a failed attempt leaves its
# version unrecorded and runs again over a database it already changed.
# if_exists: is what lets the second run skip what the first one did. The other
# REBUILD_OPERATIONS have no equivalent option -- remove_columns accepts
# if_exists: and silently discards it -- so their re-runnability stays a
# judgement call this script cannot make.
GUARDED_OPERATION = "remove_column"
GUARD = "if_exists:"

# Only migrations this repository authors. The dummy app also carries copies of
# other gems' migrations, which are regenerated by alchemy:install:migrations
# and are not ours to fix.
PATTERNS = [
  "db/migrate/*.rb",
  "spec/dummy/db/migrate/*.alchemy.rb",
  "lib/generators/**/templates/*.rb.tt"
].freeze

# Strips comments and joins continuation lines so a call split over several
# lines is matched as one statement.
def statements(source)
  source
    .gsub(/^\s*#.*$/, "")
    .gsub(/,\s*\n\s*/, ", ")
    .lines
end

def calls?(line, operation)
  line.match?(/(?:^|[^\w.])#{operation}\s*[\s(]/)
end

def offences(source)
  statements(source).flat_map do |line|
    found = REBUILD_OPERATIONS.select { |op| calls?(line, op) }
    # add_column only rebuilds when it cannot be expressed as ALTER TABLE ADD
    # COLUMN, which is what a not null column without a default requires.
    if calls?(line, "add_column") &&
        line.match?(/null:\s*false/) && !line.match?(/default:/)
      found += ["add_column (null: false without a default)"]
    end
    found
  end.uniq
end

def unguarded_removal?(source)
  statements(source).any? { |line| calls?(line, GUARDED_OPERATION) && !line.include?(GUARD) }
end

def report(title, failures)
  warn title
  warn ""
  failures.each do |path, detail|
    warn "  #{path}"
    warn "    #{detail}"
  end
  warn ""
end

transactional = []
unrepeatable = []

PATTERNS.flat_map { |pattern| Dir.glob(pattern) }.sort.each do |path|
  source = File.read(path)
  rebuilds = offences(source)
  next if rebuilds.empty?

  if source.match?(DISABLED_TRANSACTION)
    unrepeatable << [path, "#{GUARDED_OPERATION} without #{GUARD}"] if unguarded_removal?(source)
  else
    transactional << [path, rebuilds.join(", ")]
  end
end

if transactional.empty? && unrepeatable.empty?
  puts "No migration rebuilds a table inside the default DDL transaction."
  puts "Migrations that rebuild outside one can be re-run."
  exit 0
end

unless transactional.empty?
  report("Migrations that rebuild a table inside the default DDL transaction:", transactional)
  warn <<~MESSAGE

    On SQLite these operations recreate the table via DROP TABLE, whose implicit
    DELETE fires ON DELETE CASCADE and permanently empties every child table. The
    adapter's PRAGMA foreign_keys = OFF guard does not work inside a transaction.

    Add `disable_ddl_transaction!` to each migration above -- optionally as
    `disable_ddl_transaction! if connection.adapter_name.match?(/sqlite/i)`, since
    no other adapter rebuilds -- and make sure it is safe to re-run, since it no
    longer rolls back as a unit. Prefer an approach that avoids the rebuild
    altogether: `add_column` with both `null: false` and a `default:` is a plain
    ALTER TABLE ADD COLUMN, and a nullable column with a model level default works
    the same on every adapter.
  MESSAGE
end

unless unrepeatable.empty?
  report("Migrations that rebuild outside a transaction but cannot be re-run:", unrepeatable)
  warn <<~MESSAGE

    Without the transaction a failed migration leaves its version unrecorded, so
    it runs again from the top against a database the failed attempt already
    changed. Pass `if_exists: true` to every `remove_column` above so the second
    run skips the columns the first one already dropped, and check that the data
    statements around them can be repeated.
  MESSAGE
end

exit 1
