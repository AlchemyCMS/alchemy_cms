#!/usr/bin/env sh

# Start the full development environment in Docker: builds the images and
# runs the Rails dev server, Sass watcher, and JS bundle watcher.
#
# To run the dummy app locally without Docker, use bin/dev instead.

# The container user must own the bind mounted workspace to write into it. On
# Linux a uid mismatch makes the workspace read-only, so build the image with
# the host's ids. On macOS the bind mount is writable whatever the container uid
# is, and forwarding the host gid (e.g. 20) would collide with an existing
# base-image group, so leave the image default in place. An explicitly exported
# USER_ID/GROUP_ID still wins on either platform.
if [ "$(uname -s)" != "Darwin" ]; then
  USER_ID="${USER_ID:-$(id -u)}"
  GROUP_ID="${GROUP_ID:-$(id -g)}"
  export USER_ID GROUP_ID
fi

# A plain start reuses the existing image and volumes, so it is fast and never
# picks up dependency changes. `--refresh` rebuilds the image with the latest
# allowed gems and the locked npm packages, then reseeds node_modules.
refresh=""
args=""
for arg in "$@"; do
  if [ "$arg" = "--refresh" ]; then
    refresh=1
  else
    args="$args $arg"
  fi
done

if [ -n "$refresh" ]; then
  GEMS_RESOLVED_AT="$(date +%s)"
  export GEMS_RESOLVED_AT
  docker compose build || exit 1
  # Every service shadows node_modules with its own anonymous volume. Remove
  # them together with the containers so each one is reseeded from the new
  # image; --renew-anon-volumes would leave the old volumes orphaned instead.
  docker compose rm --stop --force --volumes
fi

exec docker compose up $args
