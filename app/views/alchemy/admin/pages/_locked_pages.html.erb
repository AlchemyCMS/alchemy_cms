<% if locked_pages.present? %>
  <alchemy-locked-pages id="locked_pages">
    <div class="locked-pages-list">
      <%= render partial: "alchemy/admin/pages/locked_page", collection: locked_pages %>
    </div>
    <sl-dropdown class="locked-pages-menu" placement="bottom-end" distance="4" hoist>
      <button type="button" slot="trigger" class="locked-pages-menu-button">
        <%= Alchemy.t("All locked pages") %>
        <span class="locked-pages-count"><%= locked_pages.size %></span>
        <%= render_icon("arrow-down-s", size: "1x") %>
      </button>
      <div class="locked-pages-menu-list"></div>
    </sl-dropdown>
  </alchemy-locked-pages>
<% end %>
