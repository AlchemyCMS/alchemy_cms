<% if page.definition.blank? %>
  <%= page_layout_missing_warning %>
<% end %>
<span class="page_name"><%= page.name %></span>
<% if multi_site? || page.site_languages.many? %>
  <span class="page_meta">
    <% if multi_site? %>
      <span class="page_site"><%= render_icon(:global, size: "sm") %><%= page.site_name %></span>
    <% end %>
    <% if page.site_languages.many? %>
      <span class="label page_language" title="<%= page.language.name %>"><%= page.language_code %></span>
    <% end %>
  </span>
<% end %>
