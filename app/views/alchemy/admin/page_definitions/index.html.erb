<%= content_for :toolbar do %>
  <%= form_with url: alchemy.admin_page_definitions_path, method: :get, class: "search_form" do %>
    <div class="search_field">
      <button type="submit">
        <%= render_icon(:search) %>
      </button>
      <%= search_field_tag :q, @query,
        class: "search_input_field",
        placeholder: Alchemy.t(:search) %>
      <%= link_to render_icon(:times, size: "1x"), alchemy.admin_page_definitions_path,
        class: "search_field_clear",
        title: Alchemy.t(:click_to_show_all),
        style: @query ? "visibility: visible" : "visibility: hidden" %>
    </div>
  <% end %>
<% end %>

<% if @page_definitions.any? %>
  <div class="page-definitions">
    <aside>
      <h2>
        <%= Alchemy::PageDefinition.model_name.human(count: :many) %>
      </h2>
      <ol>
        <% @page_definitions.each do |page_layout| %>
          <li>
            <%= link_to highlight(page_layout.human_name, @query), "##{page_layout.name}", data: {turbo: false} %>
          </li>
        <% end %>
      </ol>
    </aside>
    <div>
      <%= render collection: @page_definitions, partial: "page_definition" %>
    </div>
  </div>
<% else %>
  <%= render_message { Alchemy.t("Nothing found") } %>
<% end %>
