<li>
  <header>
    <strong><%= Alchemy::Ingredient.translated_label_for(ingredient_definition.role, element_name) %></strong>
    <small><%= I18n.t(Alchemy::Ingredient.normalize_type(ingredient_definition.type).underscore, scope: [:activerecord, :models], count: 1, default: ingredient_definition.type.underscore.humanize) %></small>
