<% content_for :toolbar do %>
  <div class="toolbar_buttons">
    <%= render Alchemy::Admin::ToolbarButton.new(
      icon: :plus,
      label: Alchemy.t("Add a site"),
      primary: true,
      url: new_resource_path,
      hotkey: 'alt+n',
      tooltip_placement: "top-start",
      dialog_options: {
        title: Alchemy.t("Create site"),
        size: "430x415"
      },
      if_permitted_to: [:create, Alchemy::Site]
    ) %>
  </div>
  <%= render 'alchemy/admin/partials/search_form' %>
<% end %>

<% if Alchemy::Site.any? %>
  <%= render 'alchemy/admin/resources/table_header', query: @query %>

  <% if @sites.any? %>
    <div class="resources-table-wrapper">
      <%= render 'alchemy/admin/resources/resource_table', icon: "global", query: @query %>
    </div>
  <% elsif search_filter_params.present? %>
    <%= render_message do %>
      <%= Alchemy.t(:no_search_results) %>
    <% end %>
  <% end %>

  <%= render "alchemy/admin/resources/pagination", resources: resources_instance_variable %>
<% else %>
  <%= render "alchemy/admin/resources/empty_state" do %>
    <%= render "form", site: Alchemy::Site.new(
      name: Alchemy.config.default_site.name,
      host: Alchemy.config.default_site.host,
      public: true
    ) %>
  <% end %>
<% end %>
