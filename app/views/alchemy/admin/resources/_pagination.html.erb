<% if resources.total_pages > 1 %>
  <div class="pagination-wrapper">
    <span class="pagination-entries">
      <%= sanitize t(".showing_entries_html",
        from: resources.offset_value + 1,
        to: resources.offset_value + resources.size,
        total: resources.total_count) %>
    </span>
    <% unless local_assigns[:hide_per_page_select] %>
      <%= render "alchemy/admin/resources/per_page_select" %>
      <span class="pagination-divider"></span>
    <% end %>
    <%= paginate resources, theme: "alchemy" %>
  </div>
<% end %>
