<% if request.xhr? || turbo_frame_request? %>
  <%= alchemy_form_for [:admin, @user] do |f| %>
    <%= render "fields", f: f, user_roles: @user_roles %>
  <% end %>
<% else %>
  <% content_for :toolbar do %>
    <div class="toolbar_buttons">
      <sl-tooltip content="<%= Alchemy.t(:back) %>">
        <%= render Alchemy::Admin::ToolbarButton.new(
          label: Alchemy.t(:back),
          primary: true,
          icon: "arrow-left-s",
          url: request.referer || alchemy.admin_dashboard_path,
          skip_permission_check: true,
          dialog: false
        ) %>
      </sl-tooltip>
    </div>
  <% end %>

  <div class="panel">
    <alchemy-message type="info">
      <%= Alchemy.t(:edit_user) %>
    </alchemy-message>
    <%= alchemy_form_for [:admin, @user] do |f| %>
      <%= render "fields", f: f, user_roles: @user_roles %>
    <% end %>
  </div>
<% end %>
