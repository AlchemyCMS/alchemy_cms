<%= alchemy_form_for [:admin, @user] do |f| %>
  <% carried_over_user_params.each do |name, value| %>
    <% if value.is_a?(Array) %>
      <% value.each do |item| %>
        <%= hidden_field_tag "user[#{name}][]", item, id: nil %>
      <% end %>
    <% else %>
      <%= hidden_field_tag "user[#{name}]", value, id: nil %>
    <% end %>
  <% end %>
  <%= render "confirm_password_notice", f: f %>
  <%= f.input :current_password,
    as: :password,
    required: true,
    autofocus: true,
    input_html: {autocomplete: "current-password"} %>
  <div class="submit">
    <button type="submit">
      <%= Alchemy.t(:save) %>
    </button>
  </div>
<% end %>
