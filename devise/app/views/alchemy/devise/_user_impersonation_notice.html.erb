<aside class="alchemy-user-impersonation-notice" role="status" style="position: sticky; top: 0; z-index: 10000; padding: 0.75rem 1rem; background: #fff3cd; color: #664d03; border-bottom: 1px solid #ffecb5; display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
  <span><%= t("alchemy.devise.user_impersonation.notice", user: user.alchemy_display_name) %></span>
  <%= button_to t("alchemy.devise.user_impersonation.stop"),
    alchemy.admin_user_impersonation_session_path,
    method: :delete,
    form: {data: {turbo_confirm: t("alchemy.devise.user_impersonation.stop_confirmation")}} %>
</aside>
